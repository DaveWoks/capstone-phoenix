apiVersion: v1
kind: Secret
metadata:
  name: taskapp-secret
  namespace: taskapp
type: Opaque
stringData:
  DATABASE_URL: "postgresql://YOUR_USER:YOUR_PASSWORD@postgres:5432/taskmanager"
  DATABASE_HOST: "postgres"
  DATABASE_PORT: "5432"
  DATABASE_NAME: "taskmanager"
  DATABASE_USER: "YOUR_USER"
  DATABASE_PASSWORD: "YOUR_PASSWORD"
  SECRET_KEY: "a-long-random-string-generated-yourself"
  POSTGRES_DB: "taskmanager"
  POSTGRES_USER: "YOUR_USER"
  POSTGRES_PASSWORD: "YOUR_PASSWORD"
